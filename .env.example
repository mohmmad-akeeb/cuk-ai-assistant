# ==============================================================================
# Central University of Kashmir (CUK) RAG Assistant — Environment Configuration
# ==============================================================================
# Copy this file to .env and configure your secrets.
# Strictly conforms to the 100% Free-Tier / Zero Cost Invariant (NFR-2.2).
# ==============================================================================

# ── 1. Web Crawling & Ingestion Identity ──────────────────────────────────────
# Required: Contact email included in User-Agent header for CUK portal requests
CONTACT_EMAIL=your@email.com
BASE_URL=https://www.cukashmir.ac.in
RATE_LIMIT_RPS=1.0
MAX_CONNECTIONS=2
CIRCUIT_BREAKER_THRESHOLD=5
MAX_PDF_BYTES=20971520   

# ── 2. Local File & Database Paths ───────────────────────────────────────────
CACHE_DIR=data/cache
PROCESSED_DIR=data/processed
LOGS_DIR=data/logs
REPORTS_DIR=reports
LANCEDB_DIR=data/lancedb
SQLITE_DB_PATH=data/sessions.db
LOG_LEVEL=INFO

# ── 3. Local Embedded Compute Engines (100% Free / CPU Only) ─────────────────
# FastEmbed ONNX Dense Embeddings (384d, ~5ms CPU latency, 0 API cost)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# FlashRank ONNX Cross-Encoder Reranker (~15-20ms CPU latency, 0 API cost)
RERANKER_MODEL=ms-marco-TinyBERT-L-2-v2

# Docling OCR & Layout Parser Engine
DOCLING_OCR_ENGINE=rapidocr

# ── 4. Cloud LLM Inference: Google Gemini (Free Tier) ────────────────────────
# Get your free API key at: https://aistudio.google.com/
# Free-Tier Quotas:
#   - 15 RPM (Requests Per Minute)
#   - 1,000,000 TPM (Tokens Per Minute)
#   - 1,500 RPD (Requests Per Day)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ── 5. Cloud LLM Inference & Safety: Groq Cloud (Free Tier) ───────────────────
# Get your free API key at: https://console.groq.com/
# Free-Tier Quotas:
#   - 30 RPM (Requests Per Minute)
#   - 6,000 TPM (Tokens Per Minute for Llama 3.3 70B)
#   - 1,000 RPD (Requests Per Day)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_GUARD_MODEL=llama-guard-3-8b

# ── 6. LLM Pool & Circuit Breaker Settings ────────────────────────────────────
# Multi-provider balancing strategy: round_robin | primary_failover
LLM_BALANCING_STRATEGY=round_robin
CIRCUIT_BREAKER_FAILOVER_THRESHOLD=3
CIRCUIT_BREAKER_COOLOFF_SECONDS=60

# ── 7. Observability & Telemetry Sinks ────────────────────────────────────────
# Pydantic Logfire (Unified Tracing & Metrics)
# Setup account and token at: https://logfire.pydantic.dev/
# Or authenticate via CLI: uv run logfire auth
LOGFIRE_TOKEN=your_logfire_token_here

# Langfuse (Prompt Management & RAG Traces - Optional Cloud or Self-Hosted)
# Free cloud tier (50k events/month) at: https://cloud.langfuse.com/
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# Arize Phoenix (Local Retrieval Precision & Embedding Visualizer)
# Runs locally at http://localhost:6006 ($0 cost)
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
